; DevStack Procfile
; 格式：; Name: [autorun] COMMAND [ARGS...] [KEY=VALUE...] [pwd=WORKDIR] [grace=N]
;
; 示例：
; Nginx: nginx.exe -p C:\DevStack\programs\nginx\1.26
; MySQL: mysqld.exe --defaults-file=C:\DevStack\programs\mysql\8.0\my.ini
; PHP: php-cgi.exe -b 127.0.0.1:9000
; Redis: redis-server.exe

; Nginx: nginx.exe
; MySQL: mysqld.exe
; PHP: php-cgi.exe -b 127.0.0.1:9000
; Redis: redis-server.exe
